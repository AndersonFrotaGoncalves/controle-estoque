# Copie para .env (na raiz do projeto). Tudo é opcional.

# Porta do servidor
PORT=3000

# Segredo para assinar os tokens de login (em produção, use um valor longo e aleatório)
JWT_SECRET=

# Sem as variáveis abaixo, o sistema usa SQLite (backend/data/estoque.db).
# Preencha-as para usar MySQL (crie as tabelas com backend/schema.mysql.sql).
MYSQLHOST=
MYSQLUSER=
MYSQLPASSWORD=
MYSQLDATABASE=
MYSQLPORT=3306
